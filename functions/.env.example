# Copy to functions/.env (or let `firebase deploy` prompt for these values).
# Public URL where the dashboard is hosted, no trailing slash. Used to build signing links.
APP_URL=https://your-dashboard-domain.example
# Mailbox the emails are sent from. Must be the account the app password belongs to.
SMTP_USER=monika.rm@ignite-vision.com
# The SMTP password is NOT stored in a file. Set it once as a secret:
#   firebase functions:secrets:set SMTP_PASSWORD
